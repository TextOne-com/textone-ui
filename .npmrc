# @textone-com/* lives on GitHub Packages (org TextOne-com). The token is not kept here: in
# Actions, setup-node writes it from GITHUB_TOKEN; on a laptop, ~/.npmrc holds
#   //npm.pkg.github.com/:_authToken=<a token with read:packages, or write:packages to publish>
@textone-com:registry=https://npm.pkg.github.com
