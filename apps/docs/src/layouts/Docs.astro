---
import "@fontsource/plus-jakarta-sans/400.css";
import "@fontsource/plus-jakarta-sans/500.css";
import "@fontsource/plus-jakarta-sans/600.css";
import "@fontsource/plus-jakarta-sans/700.css";
import "@fontsource/plus-jakarta-sans/800.css";
import "@fontsource/fraunces/600.css";
import { TxBrandLockup } from "@textone-com/vue";
import "../styles/docs.css";

const sections = [
  ["marca", "Brand"],
  ["color", "Color"],
  ["tipografia", "Typography"],
  ["espaciado", "Spacing and shape"],
  ["botones", "Buttons"],
  ["estados", "States and messages"],
  ["campos", "Fields"],
  ["seleccion", "Selection"],
  ["navegacion", "Tabs and dialog"],
  ["tablas", "Tables"],
  ["documento", "Document"],
  ["uso", "How to use it"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <title>Text One UI</title>
  </head>
  <body>
    <div class="mx-auto grid max-w-[1200px] grid-cols-1 gap-10 px-4 py-8 md:grid-cols-[200px_minmax(0,1fr)] md:px-8">
      <aside class="md:sticky md:top-8 md:self-start">
        <TxBrandLockup as="a" href="/" size={16} />
        <p class="mt-3 text-xs font-semibold text-ink-secondary">UI · @textone-com/tokens · @textone-com/vue</p>
        <nav aria-label="Sections" class="mt-6 flex flex-col gap-0.5">
          {
            sections.map(([id, label]) => (
              <a href={`#${id}`} class="rounded-full px-3 py-1.5 text-[13px] font-semibold text-ink no-underline hover:bg-hover hover:text-accent">
                {label}
              </a>
            ))
          }
        </nav>
      </aside>
      <main class="min-w-0"><slot /></main>
    </div>
  </body>
</html>
