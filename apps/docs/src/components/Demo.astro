---
const { label, code } = Astro.props as { label: string; code?: string };
---

<figure class="m-0 overflow-hidden rounded-sm border border-rule-strong bg-surface">
  <figcaption class="border-b border-rule px-4 py-2 text-xs font-medium text-ink-secondary">{label}</figcaption>
  <div class="flex flex-wrap items-start gap-4 p-4"><slot /></div>
  {code && <pre class="m-0 overflow-x-auto border-t border-rule bg-surface-sunken px-4 py-3 text-xs text-ink"><code>{code}</code></pre>}
</figure>
